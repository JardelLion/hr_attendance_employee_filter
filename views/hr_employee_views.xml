<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View hr.employee form -->
    <record id="view_hr_employee_form" model="ir.ui.view">
        <field name="name">view.hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_attendance.view_employee_form_inherit_hr_attendance"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ruleset_id']" position="after">
                <field name='use_attendance'/>
            </xpath>
        </field>
    </record>

    <record id="hr.open_view_employee_list_my" model="ir.actions.act_window">
        <field name="domain">[('use_attendance', '=', True), ('company_id', 'in', allowed_company_ids)]</field>
    </record>

</odoo>